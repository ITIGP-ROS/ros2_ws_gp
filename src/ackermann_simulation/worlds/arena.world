          <geometry><box><size>16.3000 0.1500 1.0000</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>16.3000 0.1500 1.0000</size></box></geometry>
          <material>
            <ambient>0.42 0.45 0.5 1</ambient>
            <diffuse>0.55 0.58 0.62 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
