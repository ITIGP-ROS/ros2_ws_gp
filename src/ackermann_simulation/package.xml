<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ackermann_simulation</name>
  <version>1.0.0</version>
  <description>
    Gazebo Classic simulation of the Ackermann vehicle. Runs the vehicle's own
    controller, EKF, twist_mux and Nav2 configuration unmodified against a simulated
    2D scanner, so a tuning change can be exercised here before it reaches the car.
  </description>
  <maintainer email="youhanabeshay@gmail.com">Youhana Beshay</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The vehicle packages. Every configuration file this package launches lives in
       ackermann_bringup; there are no simulation copies of them. -->
  <exec_depend>ackermann_bringup</exec_depend>
  <exec_depend>ackermann_description</exec_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- Gazebo Classic. This workspace has no ros_gz / Gazebo Sim packages installed and
       the launch files target Classic deliberately - see the package README. -->
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>gazebo_ros2_control</exec_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>imu_sensor_broadcaster</exec_depend>
  <exec_depend>ackermann_steering_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <!-- Only used on the sim_lidar:=livox path, alongside ros2_livox_simulation. That
       package is deliberately NOT a dependency: it is not in this workspace, and the
       default 2d path does not need it. -->
  <exec_depend>pointcloud_to_laserscan</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
