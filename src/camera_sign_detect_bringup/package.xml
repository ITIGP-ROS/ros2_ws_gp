<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>camera_sign_detect_bringup</name>
  <version>0.1.0</version>
  <description>
    V-PACE AI traffic sign detection bringup package.
    Launches a composable node container running a V4L2 camera
    and a YOLO-based detector (ros2_yolos_cpp) with lifecycle
    auto-activation for real-time inference.
  </description>
  <maintainer email="youhanabeshay@gmail.com">youhana</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>ament_index_python</build_depend>
  <build_depend>launch</build_depend>
  <build_depend>launch_ros</build_depend>
  <build_depend>rclcpp_components</build_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>v4l2_camera</exec_depend>
  <exec_depend>ros2_yolos_cpp</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
