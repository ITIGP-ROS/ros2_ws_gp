<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


    <!-- ====== CAMERA LINK ====== -->
    <link name="camera_link">
        <visual>
            <geometry>
                <box size="0.010 0.03 0.03"/>
            </geometry>
            <material name="black"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.010 0.03 0.03"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.05"/>
            <inertia ixx="0.000001" ixy="0.0" ixz="0.0"
                    iyy="0.000001" iyz="0.0" izz="0.000001"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </inertial>
    </link>

    <!-- ====== CAMERA JOINT ====== -->
    <joint name="camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera_link"/>
        <origin xyz="0.25 0 0.099" rpy="0 0 0"/>
    </joint>

    <!-- ====== CAMERA OPTICAL LINK ====== -->
    <link name="camera_optical_frame"></link>

    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_optical_frame"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- ====== CAMERA GAZEBO ======= -->
    <gazebo reference="camera_link">
            <sensor name="camera" type="camera">
                <always_on>1</always_on>
                <update_rate>20</update_rate>
                <visualize>true</visualize>
                <camera>
                    <horizontal_fov>1.3962634</horizontal_fov>
                    <image>
                        <width>1920</width>
                        <height>1080</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>15</far>
                    </clip>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.007</stddev>
                    </noise>
                </camera>
                <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
                    <ros>
                        <remapping>~/image_raw:=camera/image_raw</remapping>
                        <remapping>~/camera_info:=camera/camera_info</remapping>
                    </ros>
                    <camera_name>camera</camera_name>
                    <!-- Match your actual optical link name -->
                    <frame_name>camera_optical_frame</frame_name>
                    <hack_baseline>0.0</hack_baseline>
                </plugin>
            </sensor>
    </gazebo>


    <xacro:if value="$(arg hardware)">    
    <!-- ====== LIDAR LINK ====== -->
    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="0.035" length="0.04"/>
            </geometry>
            <material name="black"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.035" length="0.04"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.17"/>
            <inertia ixx="0.000075" ixy="0.0" ixz="0.0"
                    iyy="0.000075" iyz="0.0" izz="0.0001"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </inertial>
    </link>

    <!-- ====== LIDAR JOINT ====== -->
    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="0.13 0 0.279" rpy="0 0 0"/>
    </joint>

    <!-- Frame for the Mid-360 internal IMU, which publishes /livox/imu.
         PROVISIONAL OFFSET - identity is a placeholder, not the real extrinsic.
         Replace with the measured value before trusting any LIO result. -->

    <link name="livox_frame"/>

    <joint name="livox_imu_joint" type="fixed">
        <parent link="lidar_link"/>
        <child link="livox_frame"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- ====== LIDAR GAZEBO ======= -->
     <gazebo reference="lidar_link">
        <!-- Classic uses 'ray' instead of 'gpu_lidar' -->
        <sensor name="lidar" type="ray">
            <pose> 0 0 0 0 0 0 </pose>
            <always_on>1</always_on>
            <update_rate>10</update_rate>
            <visualize>true</visualize>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1.0</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.15</min>
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
            <plugin name="laser_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <remapping>~/out:=scan</remapping>
                </ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>lidar_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>
    </xacro:if>

     <xacro:unless value="$(arg hardware)"> 
    <!-- ====== LIDAR MID360s ======= -->
     <xacro:include filename="$(find ros2_livox_simulation)/urdf/mid360.xacro" />

    <xacro:mid360 name="livox" parent="base_link" topic="mid360">
        <origin xyz="0.13 0 0.279" rpy="0 0 0"/>
    </xacro:mid360>
    </xacro:unless>

    <!-- ====== IMU LINK ====== -->
    <link name="imu_link">
        <visual>
            <geometry>
                <box size="0.02 0.015 0.005"/>
            </geometry>
            <material name="black"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.02 0.015 0.005"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.01"/>
            <inertia ixx="0.000001" ixy="0.0" ixz="0.0"
                    iyy="0.000001" iyz="0.0" izz="0.000001"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </inertial>
    </link>

    <!-- ====== IMU JOINT ====== -->
    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0.092 -0.03 0.018" rpy="0 0 0"/>
    </joint>

    <!-- ====== IMU GAZEBO  ====== -->
    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <always_on>true</always_on>
            <update_rate>100</update_rate>
            <visualize>true</visualize>
            <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
                <ros>
                    <remapping>~/out:=imu/data</remapping>
                </ros>
                <frame_name>imu_link</frame_name>
                <initial_orientation_as_reference>false</initial_orientation_as_reference>
            </plugin>
        </sensor>
    </gazebo>

</robot>